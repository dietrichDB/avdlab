# Copy to deploy/.env and edit.  Every setting in backend/avdlab/core/config.py can be set as AVDLAB_<NAME>.

# ---- published port on the Docker host (compose only, not read by the app)

AVDLAB_PORT=8080

# host address the API port binds to: 0.0.0.0 (LAN install) or 127.0.0.1 with the `public` profile, so the app is
# reachable only through Caddy (or `ssh -L 8080:127.0.0.1:8080 <vm>`)

AVDLAB_BIND_ADDRESS=0.0.0.0

# DNS name with an A record pointing at this host (create it BEFORE the first start) + ACME contact address
# AVDLAB_DOMAIN=avdlab.example.com
# AVDLAB_ACME_EMAIL=you@example.com
# true → Let's Encrypt staging CA (test certificates, browsers warn) — for dry runs; remove for the real certificate
# AVDLAB_ACME_STAGING=false
# the URL users open; https:// → Secure session cookie, and it is added to AVDLAB_CORS_ORIGINS automatically
# AVDLAB_PUBLIC_URL=https://avdlab.example.com
# empty = derived from AVDLAB_PUBLIC_URL; true forces the Secure cookie flag (login then only works over https)
# AVDLAB_SECURE_COOKIES=
# trust X-Forwarded-Proto/For from the reverse proxy (client IPs in the audit log). Only with the API not published
# on a public address (AVDLAB_BIND_ADDRESS=127.0.0.1), otherwise clients could spoof their IP.
# AVDLAB_TRUST_PROXY_HEADERS=false

# ---- auth (single admin) — CHANGE THESE

AVDLAB_ADMIN_USER=admin
AVDLAB_ADMIN_PASSWORD=change-me

# random string, e.g. `openssl rand -hex 32`

AVDLAB_SESSION_SECRET=change-me-session-secret
AVDLAB_SESSION_MAX_AGE=604800

# v0.8.0 accounts: the admin above is created on first start (a default/weak password forces a change at first sign-in);
# further users, roles (admin/operator/viewer) and TOTP MFA are managed on the Users / Account pages
# AVDLAB_PASSWORD_MIN_LENGTH=12
# AVDLAB_LOGIN_MAX_FAILURES=5
# AVDLAB_LOGIN_LOCKOUT_MINUTES=15
# AVDLAB_MFA_ISSUER=avdlab

# ---- secret store (Fernet key). Empty → generated on first start and kept in <data_dir>/secret.key.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

AVDLAB_SECRET_KEY=

# ---- storage
AVDLAB_DATA_DIR=/data

# sqlite (default) or postgres (start compose with `--profile postgres`):

AVDLAB_DATABASE_URL=sqlite+aiosqlite:////data/avdlab.db

# AVDLAB_DATABASE_URL=postgresql+asyncpg://avdlab:avdlab@db:5432/avdlab

POSTGRES_PASSWORD=avdlab

# templates shipped in the image at /app/templates

AVDLAB_TEMPLATES_DIR=/app/templates

# ---- lab hosts

AVDLAB_AGENT_IMAGE=ghcr.io/aristanetworks/avd/universal:python3.11-avd-v6.4.0
AVDLAB_CLAB_IMAGE=ghcr.io/srl-labs/clab:latest

# ANTA image used for the security advisory scan (`anta psirt`, needs ANTA >= 1.10); pulled on the lab host on first use

AVDLAB_ANTA_IMAGE=ghcr.io/aristanetworks/anta:1.10.0
AVDLAB_REMOTE_ROOT=/opt/avdlab

# ---- pinned toolchain

AVDLAB_AVD_VERSION=6.4.0
AVDLAB_ANTA_VERSION=1.10.0

# ---- CORS (JSON list; only needed for the Vite dev server)

AVDLAB_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ---- NetBox (optional, `docker compose --profile netbox up -d`; see README "NetBox")
# NETBOX_VERSION=v4.2
# NETBOX_PORT=8000
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"

NETBOX_SECRET_KEY=

# superuser API token, 40 hex characters: python3 -c "import secrets; print(secrets.token_hex(20))"

NETBOX_API_TOKEN=
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@example.com
NETBOX_SUPERUSER_PASSWORD=change-me
NETBOX_DB_PASSWORD=netbox
NETBOX_REDIS_PASSWORD=netbox

# create GitHub issues for feedback entries: owner/repo + a secret named `github_token` (Secrets page)
# AVDLAB_FEEDBACK_GITHUB_REPO=owner/repo
# build info is baked into the image: AVDLAB_GIT_SHA=$(git rev-parse --short=12 HEAD) AVDLAB_BUILD_DATE=$(date -u +%FT%TZ) docker compose build

# Where to look for new releases: GitHub Releases of a repo, or a manifest URL returning
# {"latest": "0.7.0", "url": "...", "notes": "...", "published_at": "...", "image": "ghcr.io/<owner>/avdlab:0.7.0"}.
# Empty = no update checks.
# AVDLAB_UPDATE_SOURCE=github:<owner>/<repo>
# source (default): git pull --ff-only + docker compose up -d --build (this checkout must be a git clone)
# image:            pull the release image (AVDLAB_IMAGE is rewritten in this .env) + docker compose up -d api
# manual:           only show that an update exists
# AVDLAB_UPDATE_MODE=source
# AVDLAB_UPDATE_CHECK_INTERVAL=24
# "Update now" also needs the docker.sock mount in docker-compose.yml and the HOST path of this deploy/ dir.
# docker-compose.yml passes ${PWD} (the directory you run compose in) when this is unset; set it explicitly if you
# run compose with -f from elsewhere:
# AVDLAB_DEPLOY_DIR=/Users/me/avdlab/deploy
# image used by the api service (image mode updates this line)
# AVDLAB_IMAGE=ghcr.io/<owner>/avdlab:latest

# These only seed the defaults: Admin settings (/admin/settings) stores its own values in the database, which win.
# AVDLAB_APP_TITLE=avdlab
# AVDLAB_GITHUB_URL=https://github.com/<owner>/avdlab
# AVDLAB_SUPPORT_EMAIL=avdlab-support@example.com
# AVDLAB_REGISTRATION_ENABLED=true
# AVDLAB_INTRO_VIDEO_URL=/intro/avdlab-intro.mp4
# AVDLAB_FEEDBACK_MAIL_TO=dietrich@arista.com
# AVDLAB_FEEDBACK_MAIL_ENABLED=true
# AVDLAB_REGISTRATION_MAIL_TO=            # empty = AVDLAB_FEEDBACK_MAIL_TO

# SMTP: empty host = no e-mail at all. Port 465 = implicit TLS, otherwise STARTTLS when AVDLAB_SMTP_STARTTLS=true.
# AVDLAB_SMTP_HOST=smtp.office365.com
# AVDLAB_SMTP_PORT=587
# AVDLAB_SMTP_USER=avdlab@example.com
# AVDLAB_SMTP_PASSWORD=                   # better: set it in Admin settings (encrypted in the secret store)
# AVDLAB_SMTP_STARTTLS=true
# AVDLAB_SMTP_FROM=                       # empty = avdlab@<host of AVDLAB_PUBLIC_URL, or localhost>

# Values set in Admin settings → AI assistant win. Lab data (knob values, topology summary; never secrets) goes to it.
# AVDLAB_AI_DEFAULT_PROVIDER=openai        # anthropic | openai (OpenAI-compatible: OpenAI, Ollama, LM Studio, vLLM, Azure)
# AVDLAB_AI_DEFAULT_BASE_URL=http://ollama:11434/v1
# AVDLAB_AI_DEFAULT_MODEL=qwen2.5:14b
# AVDLAB_AI_DEFAULT_API_KEY=               # better: set it in Admin settings (encrypted in the secret store)
# AVDLAB_AI_SHARED_ALLOWED=false
# AVDLAB_AI_RATE_LIMIT=30                  # design calls per user per hour
# AVDLAB_AI_TIMEOUT=180
